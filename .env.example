# Database
DATABASE_URL="postgresql://user:password@localhost:5432/booking_system_db?schema=public"

# Authentication
AUTH_SECRET="change-this-to-a-secure-random-32-char-secret"

# Paystack (Ghana mobile money & cards)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# SMS Service (Arkesel / mNotify)
SMS_API_KEY="your-sms-api-key"

# Application URL
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
