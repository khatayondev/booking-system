# ==============================================================================
# Aura Beauty Studio - Production Environment Variables
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="production"

# Base Application URL (Required for CSRF protection, webhooks, and absolute URLs)
APP_URL="https://aurastudio.gh"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 with btree_gist extension)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://aura_user:AuraStudio2026_SecureDb@localhost:5432/booking_system_db?schema=public"

# ------------------------------------------------------------------------------
# Cryptographic Secrets & Authentication
# ------------------------------------------------------------------------------
# Session signing secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_MIN_32_CHAR_BASE64_RANDOM_SECRET"
NEXTAUTH_SECRET="REPLACE_WITH_MIN_32_CHAR_BASE64_RANDOM_SECRET"

# Field-level AES-256-GCM encryption key for secrets stored at rest
# (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY="REPLACE_WITH_EXACTLY_64_HEX_CHARACTERS_FOR_AES_256"

# ------------------------------------------------------------------------------
# Payment Gateway: Paystack Ghana (Cards & Mobile Money - MTN, Telecel, AT)
# ------------------------------------------------------------------------------
# Go-Live: Replace 'pk_test_' and 'sk_test_' with 'pk_live_' and 'sk_live_'
PAYSTACK_PUBLIC_KEY="pk_live_YOUR_PAYSTACK_PUBLIC_KEY"
PAYSTACK_SECRET_KEY="sk_live_YOUR_PAYSTACK_SECRET_KEY"

# ------------------------------------------------------------------------------
# Ghana SMS Provider: Arkesel / mNotify
# ------------------------------------------------------------------------------
ARKESEL_API_KEY="your-arkesel-api-key"
ARKESEL_SENDER_ID="AuraStudio"
SMS_API_KEY="your-arkesel-api-key"

# ------------------------------------------------------------------------------
# Error Monitoring: Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN="https://your-sentry-key@o000000.ingest.sentry.io/0000000"

# ------------------------------------------------------------------------------
# Firebase Analytics & Services
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyBI7WIa0AJJsK1VOMhf6b7_seA1zaeTdoI"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="beccas-crown.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="beccas-crown"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="beccas-crown.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="618803495150"
NEXT_PUBLIC_FIREBASE_APP_ID="1:618803495150:web:dae3c373e61e529876b3ff"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-7DBRESB6DX"

